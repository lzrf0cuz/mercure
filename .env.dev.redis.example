# Redis-transport dev overlay, loaded by `task dev:redis` before .env.dev.
# Local copy: `task setup` creates .env.dev.redis from this file; edit the copy.
# go-task dotenv is first-wins, so this MERCURE_EXTRA_DIRECTIVES replaces
# .env.dev's bolt one; every other variable comes from .env.dev.
# Development only: do not use these secrets or origins in production.

MERCURE_EXTRA_DIRECTIVES="
cors_origins https://localhost
publish_origins *
playground
subscriptions
anonymous
transport redis {
    url redis://localhost:6379
    stream mercure
    max_length 10000
    encoding json
    event_ttl 24h
    cleanup_interval 5m
}
heartbeat 15s
write_timeout 300s"
