# Homebrew packages that `task ci` and `task verify` need.
# `task setup` runs `brew bundle --file=Brewfile`; `task doctor` checks them.
# Docker is a separate prerequisite and is not installed here.
# dashboard-linter has no formula; `task setup` installs a pinned release.
brew "go"
brew "go-task"
brew "golangci-lint"
brew "govulncheck"
brew "rumdl"
brew "shellcheck"
brew "shfmt"
brew "node"
brew "biome"
